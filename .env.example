# Copy to .env and fill in for your deployment. .env is gitignored.

# mediamtx control API base, used to discover which ABR rungs are live.
# Must be reachable from inside the clawcam-app container. On a macvlan
# setup, two containers on the same host cannot reach each other by service
# name or by each other's macvlan IP, so use a host-reachable FQDN:port.
CLAWCAM_APP_MEDIAMTX_API=http://mediamtx.example.com:9997

# Base URL where mediamtx serves the single-rendition rung playlists
# (<base>/<cam>_<height>/index.m3u8). The ABR master playlist fetches these.
CLAWCAM_APP_HLS_BASE=https://stream.example.com

# WebRTC (WHEP) base for the low-latency live view. If wrong/unset the player
# falls back to multi-second HLS, which makes PTZ feel laggy.
CLAWCAM_APP_WEBRTC_BASE=https://stream.example.com:8889

# RTSP base advertised to native clients (e.g. the Android app).
CLAWCAM_APP_RTSP_BASE=rtsp://stream.example.com:8554

# Host directory bind-mounted to /app/data (sqlite DB + media live here).
CLAWCAM_APP_DATA_HOST_DIR=/srv/clawcam-app/data

# Host directory holding fullchain.pem + key.pem, mounted read-only.
CLAWCAM_APP_TLS_CERT_HOST_DIR=/srv/clawcam-app/certs

# Name of the pre-existing external macvlan network to attach to.
CLAWCAM_APP_NETWORK=lan-dhcp

# Optional: pin the container MAC to keep a stable DHCP lease/IP across
# recreates. Leave blank to let Docker auto-assign (DNS still follows the
# hostname).
CLAWCAM_APP_MAC=

# Optional shared-secret token for write endpoints (blank = disabled).
CLAWCAM_APP_TOKEN=
